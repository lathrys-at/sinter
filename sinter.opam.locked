opam-version: "2.0"
name: "sinter"
version: "dev"
synopsis:
  "Plan, specification, and test tracing for agentic coding workflows"
description:
  "Sinter reads tags in a repository's own text files. It uses them to check that code, tests, and documents keep the agreements a project made. It reads the state of the work from files and from test results, never from an agent's self-report. The design is in docs/design-notes.md; the formats are specified in spec/."
maintainer: "The Sinter Authors"
authors: "The Sinter Authors"
license: "Apache-2.0"
depends: [
  "alcotest" {= "1.9.1" & with-test}
  "astring" {= "0.8.5" & with-test}
  "base" {= "v0.17.3" & with-dev-setup}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "camlp-streams" {= "5.0.1" & with-dev-setup}
  "cmdliner" {= "2.1.1"}
  "compiler-cloning" {= "disabled"}
  "csexp" {= "1.5.2" & with-dev-setup}
  "dune" {= "3.24.2"}
  "dune-build-info" {= "3.24.2"}
  "dune-configurator" {= "3.24.2" & with-dev-setup}
  "either" {= "1.0.0" & with-dev-setup}
  "fix" {= "20250919" & with-dev-setup}
  "fmt" {= "0.11.0" & with-test}
  "fpath" {= "0.7.3" & with-dev-setup}
  "menhir" {= "20260209" & with-dev-setup}
  "menhirCST" {= "20260209" & with-dev-setup}
  "menhirGLR" {= "20260209" & with-dev-setup}
  "menhirLib" {= "20260209" & with-dev-setup}
  "menhirSdk" {= "20260209" & with-dev-setup}
  "ocaml" {= "5.5.0"}
  "ocaml-base-compiler" {= "5.5.0"}
  "ocaml-compiler" {= "5.5.0"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0" & with-test}
  "ocaml-version" {= "4.1.3" & with-dev-setup}
  "ocaml_intrinsics_kernel" {= "v0.17.2" & with-dev-setup}
  "ocamlbuild" {= "0.16.1" & with-test}
  "ocamlfind" {= "1.9.9~preview" & with-test}
  "ocamlformat" {= "0.29.0" & with-dev-setup}
  "ocamlformat-lib" {= "0.29.0" & with-dev-setup}
  "ocp-indent" {= "1.9.0" & with-dev-setup}
  "qcheck-alcotest" {= "0.91" & with-test}
  "qcheck-core" {= "0.91" & with-test}
  "re" {= "1.14.0" & with-test}
  "sexplib0" {= "v0.17.0" & with-dev-setup}
  "stdio" {= "v0.17.0" & with-dev-setup}
  "stdlib-shims" {= "0.3.0" & with-test}
  "topkg" {= "1.1.1" & with-test}
  "uucp" {= "17.0.0" & with-dev-setup}
  "uuseg" {= "17.0.0" & with-dev-setup}
  "uutf" {= "1.0.4" & with-test}
  "yojson" {= "3.0.0" & with-test}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
homepage: "https://github.com/lathrys-at/sinter"
bug-reports: "https://github.com/lathrys-at/sinter/issues"
dev-repo: "git+https://github.com/lathrys-at/sinter.git"