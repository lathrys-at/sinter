(library
 (name sinter_core)
 (public_name sinter.core)
 ; sinter.bridge is native only, so this library is native only.
 (modes native)
 (libraries sinter_bridge unix yojson)
 (instrumentation
  (backend bisect_ppx)))

; git_version.ml holds the output of "git describe" for the current
; state of the checkout. The rule runs on every build; dependents
; rebuild only when the description changes. Without git (a release
; archive), the module holds "unknown" and is not used: release
; builds take their version from the package instead.

(rule
 (targets git_version.ml)
 (deps (universe))
 (action
  (with-stdout-to
   git_version.ml
   (system
    "printf 'let describe = \"%s\"\\n' \"$(git describe --always --dirty 2>/dev/null || echo unknown)\""))))

; The interface of the generated module. A rule writes it, because a
; module of the library holds an interface file and this module has no
; source file of its own.

(rule
 (targets git_version.mli)
 (action
  (with-stdout-to
   git_version.mli
   (echo
    "val describe : string\n(** The description of the checkout that built this library, as\n    [git describe --always --dirty] gives it. It is [\"unknown\"] when the\n    build read no checkout. *)\n"))))
