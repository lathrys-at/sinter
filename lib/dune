(library
 (name sinter_core)
 (public_name sinter.core)
 (modes native)
 (libraries sinter_bridge unix yojson fmt uucp)
 (instrumentation
  (backend bisect_ppx))
 (instrumentation
  (backend mutaml)))

(rule
 (targets git_version.ml)
 (deps (universe))
 (action
  (with-stdout-to
   git_version.ml
   (system
    "printf 'let describe = \"%s\"\\n' \"$(git describe --always --dirty --match 'v[0-9]*' 2>/dev/null || echo unknown)\""))))

(rule
 (targets git_version.mli)
 (action
  (with-stdout-to
   git_version.mli
   (echo
    "val describe : string\n(** The description of the checkout that built this library, as\n    [git describe --always --dirty --match 'v[0-9]*'] gives it. It is [\"unknown\"] when the\n    build read no checkout. *)\n"))))

(rule
 (targets markdown_pack.ml)
 (action
  (with-stdout-to
   markdown_pack.ml
   (run
    %{exe:embed/embed.exe}
    grammar
    %{dep:markdown/tree-sitter-markdown.wasm}
    query
    %{dep:markdown/blocks.scm}))))
