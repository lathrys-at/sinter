# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A linter for keeping your specs, plans, and code in sync"
description:
  "Sinter reads the tags in a repository's files: specs, plans, decision records, and the code and tests that refer to them. It reports where they have drifted apart, for example a test that checks an old version of a spec, or a plan step whose promised work never showed up. The design is in docs/design-notes.md; the formats are specified in spec/."
maintainer: ["The Sinter Authors"]
authors: ["The Sinter Authors"]
license: "Apache-2.0"
homepage: "https://github.com/lathrys-at/sinter"
bug-reports: "https://github.com/lathrys-at/sinter/issues"
depends: [
  "ocaml" {>= "5.5"}
  "dune" {>= "3.16"}
  "cmdliner" {>= "1.3"}
  "dune-build-info"
  "yojson"
  "fmt" {>= "0.9.0"}
  "uucp"
  "alcotest" {with-test}
  "qcheck-core" {with-test & >= "0.90"}
  "qcheck-alcotest" {with-test & >= "0.90"}
  "ocamlformat" {with-dev-setup & = "0.29.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lathrys-at/sinter.git"
